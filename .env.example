# Kopieer dit bestand naar .env en pas het aan.
# .env staat in .gitignore en wordt nooit naar de browser of GitHub gestuurd.

# Modus: "demo" (standaard, geen API-aanroepen, geen kosten)
#     of "api"  (live analyse met Claude en web search, kost API-tegoed)
# Je kunt ook eenmalig kiezen met: npm run demo  /  npm run live
MODUS=demo

# Alleen nodig voor de live modus
ANTHROPIC_API_KEY=

# Optioneel
PORT=3000
